# Application & Runtime
NODE_ENV="development"
PORT="3000"
TZ="Asia/Kolkata"
APP_URL="http://localhost:3000"

# Authentication & Session Security
JWT_SECRET="replace-with-strong-32-char-secret-in-production"
COOKIE_SECURE="false"

# Database (PostgreSQL / AWS RDS for Production; local SQLite fallback in dev sandbox)
DATABASE_URL="postgresql://medicloud_app:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/medicloud?schema=public"

# AWS Cloud Services (S3 Private Bucket + SES Email Notifications)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="medicloud-private-records-prod"
AWS_SES_FROM_EMAIL="notifications@medicloud.example.com"
# Note: In AWS EC2/ECS production, prefer IAM Instance Roles instead of static keys.

# Optional AI Capabilities (Server-side only)
GEMINI_API_KEY=""
