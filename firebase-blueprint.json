{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Public/display identity record for a MediCloud user without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["PATIENT", "DOCTOR", "ADMIN"] },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "fullName", "isActive", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document for user email and phone.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted marker collection identifying clinic administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "PatientProfile": {
      "title": "PatientProfile",
      "description": "Patient demographic and clinical baseline summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "maxLength": 30 },
        "bloodGroup": { "type": "string", "maxLength": 10 },
        "allergies": { "type": "string", "maxLength": 500 },
        "emergencyContact": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fullName", "updatedAt"]
    },
    "DoctorProfile": {
      "title": "DoctorProfile",
      "description": "Public directory profile for verified MediCloud physicians.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "specialization": { "type": "string", "minLength": 2, "maxLength": 100 },
        "department": { "type": "string", "minLength": 2, "maxLength": 100 },
        "licenseNumber": { "type": "string", "minLength": 4, "maxLength": 64 },
        "experienceYears": { "type": "number" },
        "consultationFee": { "type": "number" },
        "bio": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "fullName", "specialization", "department", "licenseNumber", "isActive", "updatedAt"]
    },
    "DoctorAvailability": {
      "title": "DoctorAvailability",
      "description": "Recurring weekly availability windows for a doctor in Asia/Kolkata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dayOfWeek": { "type": "number" },
        "startTime": { "type": "string", "minLength": 5, "maxLength": 5 },
        "endTime": { "type": "string", "minLength": 5, "maxLength": 5 },
        "slotDurationMinutes": { "type": "number" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["id", "doctorId", "doctorUid", "dayOfWeek", "startTime", "endTime", "slotDurationMinutes", "isAvailable"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Scheduled clinical visit linking a patient and doctor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scheduledStart": { "type": "string", "minLength": 10, "maxLength": 40 },
        "scheduledEnd": { "type": "string", "minLength": 10, "maxLength": 40 },
        "timezone": { "type": "string", "enum": ["Asia/Kolkata"] },
        "status": { "type": "string", "enum": ["REQUESTED", "APPROVED", "COMPLETED", "REJECTED", "CANCELLED", "RESCHEDULED", "NO_SHOW"] },
        "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
        "consultationNotes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "patientUid", "doctorId", "doctorUid", "scheduledStart", "scheduledEnd", "timezone", "status", "reason", "createdAt", "updatedAt"]
    },
    "MedicalRecord": {
      "title": "MedicalRecord",
      "description": "Metadata and private storage reference for uploaded medical reports.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uploadedByDoctorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uploadedByDoctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "minLength": 2, "maxLength": 80 },
        "fileName": { "type": "string", "minLength": 3, "maxLength": 200 },
        "mimeType": { "type": "string", "enum": ["application/pdf", "image/jpeg", "image/png"] },
        "fileSizeBytes": { "type": "number" },
        "storageKey": { "type": "string", "minLength": 8, "maxLength": 260 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "patientUid", "uploadedByDoctorId", "uploadedByDoctorUid", "title", "category", "fileName", "mimeType", "fileSizeBytes", "storageKey", "createdAt"]
    },
    "RecordSharingPermission": {
      "title": "RecordSharingPermission",
      "description": "Patient-controlled time-bound consent grant for sharing a record with a doctor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recordId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "doctorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isActive": { "type": "boolean" },
        "expiresAt": { "type": "string", "minLength": 10, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recordId", "patientUid", "doctorUid", "isActive", "expiresAt", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User-scoped appointment and medical record notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "minLength": 2, "maxLength": 64 },
        "subject": { "type": "string", "minLength": 2, "maxLength": 200 },
        "message": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "type", "subject", "message", "isRead", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational and access audit entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 2, "maxLength": 80 },
        "resourceType": { "type": "string", "minLength": 2, "maxLength": 64 },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "action", "resourceType", "resourceId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User account role & display metadata."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII (email, phone) readable only by owner or admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted admin role marker documents."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientProfile" },
      "description": "Patient demographic and baseline clinical profile."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/DoctorProfile" },
      "description": "Public directory of active MediCloud doctors."
    },
    "/doctorAvailability/{availabilityId}": {
      "schema": { "$ref": "#/entities/DoctorAvailability" },
      "description": "Doctor weekly consultation slots."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Patient-doctor appointment bookings and statuses."
    },
    "/medicalRecords/{recordId}": {
      "schema": { "$ref": "#/entities/MedicalRecord" },
      "description": "Medical report metadata (files stored separately in private storage)."
    },
    "/recordSharingPermissions/{permissionId}": {
      "schema": { "$ref": "#/entities/RecordSharingPermission" },
      "description": "Explicit time-bound consent grants for medical record sharing."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable activity and record access audit trail."
    }
  }
}
